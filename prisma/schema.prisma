// Data model for the booking backend.
//
// Scope decision: the *catalogue* (services, FAQ, site copy) stays in code
// (lib/services.ts, lib/faq.ts, lib/site.ts). Only the transactional data —
// clients, their bookings, and the individual appointments/sessions — lives in
// Postgres. A Booking therefore snapshots the service it was made against
// (serviceSlug + serviceName) rather than pointing at a Service table.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon's pooled URL can't run migrations reliably; point DIRECT_URL at the
  // non-pooled connection string (host without "-pooler").
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums — mirror the string unions already used on the front end
// (lib/services.ts ServiceFlow, lib/bookings.ts BookingKind/BookingStatus).
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  STAFF
}

/// "scheduled" -> calendar + bank transfer; "assisted" -> WhatsApp hand-off.
enum ServiceFlow {
  SCHEDULED
  ASSISTED
}

enum BookingKind {
  ONE_OFF
  PROGRAMME
  CORPORATE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  DECLINED
  COMPLETED
  CANCELLED
}

/// Manual bank-transfer lifecycle: client transfers, taps "sent notification",
/// then an admin verifies the receipt.
enum PaymentStatus {
  AWAITING
  NOTIFIED
  VERIFIED
}

enum AppointmentState {
  UPCOMING
  ACTIVE
  DONE
}

/// Where a session happens. Picked by the client alongside the date and time.
/// VIRTUAL is the default: a client who never touches the toggle gets a video
/// call, which is recoverable — silently defaulting to PHYSICAL would send
/// someone across Lagos for a meeting nobody prepared for.
enum BookingMode {
  VIRTUAL
  PHYSICAL
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

/// Admin/staff accounts. Auth.js (NextAuth) tables will be added alongside this
/// when the auth milestone lands; kept minimal for now.
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A customer who submitted a booking. Not an authenticated account — this is
/// the contact captured by the /book/details form (and the admin "new booking"
/// dialog).
model Client {
  id        String    @id @default(cuid())
  fullName  String
  email     String
  phone     String?
  whatsapp  String?
  address   String?
  bookings  Booking[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([email])
}

/// One booking of one service by one client. Carries a snapshot of the service
/// so catalogue edits never rewrite history.
model Booking {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  serviceSlug String
  serviceName String
  kind        BookingKind
  flow        ServiceFlow

  status        BookingStatus @default(PENDING)
  paymentStatus PaymentStatus @default(AWAITING)

  /// Virtual (video call) or physical (at the Egbeda office). Set by every flow
  /// that passes the calendar step; Premium is arranged over WhatsApp and keeps
  /// the default.
  mode BookingMode @default(VIRTUAL)

  /// Optional free-text note from the booking form: a health concern on the
  /// scheduled flow, anything else worth knowing on an enquiry.
  note String?
  /// Programme deliverables (e.g. "Personalized Meal Plan"). Templated from the
  /// service but stored per-booking so they can be checked off later.
  deliverables String[] @default([])

  appointments Appointment[]

  /// The event brief, for the two services that collect one (Corporate Wellness,
  /// Events Training). Null everywhere else.
  enquiry Enquiry?

  /// First month a One-on-One Premium engagement is no longer listed. Set by
  /// "Opt out" to unsubscribe a client from the viewed month onward, keeping
  /// earlier months' history intact. Stored as a day-instant like scheduledAt.
  endsAt DateTime?

  paymentNotifiedAt DateTime?
  paymentVerifiedAt DateTime?

  /// Payment-gateway transaction reference (Paystack). Unique so one gateway
  /// payment can only ever finalize one booking — the backstop that makes the
  /// webhook and the return page idempotent when both fire. Null for manual
  /// bank transfers, which have no gateway reference.
  paymentReference String? @unique
  /// How the customer paid: "paystack" (card) or "manual" (bank transfer). Lets
  /// the admin board tell the two apart; null on pre-existing rows.
  paymentProvider String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([status])
  @@index([serviceSlug])
  @@index([createdAt])
}

/// A single meeting. A one-off booking has exactly one; a programme/corporate
/// booking has several (WEEK 1/2/4/6, Day 1-5). scheduledAt is null for the
/// assisted flow until the Team arranges it over WhatsApp.
model Appointment {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  label       String? // "WEEK 1", "Day 1"
  title       String? // "Initial Consultation"
  scheduledAt DateTime?
  state       AppointmentState @default(UPCOMING)
  position    Int              @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@index([scheduledAt])
}

/// The event brief behind a Corporate Wellness or Events Training booking,
/// collected on /book/enquiry. Its own table rather than columns on Booking:
/// the answers are all-or-nothing and only two of the five services ask for them.
///
/// The date of the event is deliberately NOT here — it is the booking's
/// Appointment.scheduledAt, picked on the normal calendar step, so an event
/// holds its slot and lands on the admin board like any other appointment.
model Enquiry {
  id        String  @id @default(cuid())
  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  organization String
  location     String
  /// Free text, not a number: enquiries say "about 200" or "50-100".
  audienceSize String
  topic        String
  /// Free text for the same reason: "1hr 30min", "2 days".
  duration     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
